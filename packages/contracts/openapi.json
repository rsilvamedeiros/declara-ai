{
  "openapi": "3.1.0",
  "info": {
    "title": "declara-ai API",
    "version": "0.1.0",
    "description": "SPEC-0008. Valores monetários trafegam como string decimal."
  },
  "paths": {
    "/fields": {
      "post": {
        "summary": "Cria campo manual",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ManualFieldInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Field"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/people/{personId}/years/{year}/fields": {
      "get": {
        "summary": "Lista campos da pessoa e ano, inclusive rejeitados",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "personId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 9999
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Field"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/fields/{id}/confirm": {
      "post": {
        "summary": "Confirma campo extraído",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Field"
                }
              }
            }
          },
          "404": {
            "description": "Não encontrado (inclui id de outro dono)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Transição inválida ou valor ambíguo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/fields/{id}/correct": {
      "post": {
        "summary": "Corrige campo extraído",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CorrectionInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Field"
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Não encontrado (inclui id de outro dono)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Transição inválida ou valor ambíguo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/fields/{id}/reject": {
      "post": {
        "summary": "Rejeita campo extraído",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Field"
                }
              }
            }
          },
          "404": {
            "description": "Não encontrado (inclui id de outro dono)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Transição inválida ou valor ambíguo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/people/{personId}/years/{year}/alerts": {
      "get": {
        "summary": "Alertas de consistência V-011",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "personId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1000,
              "maximum": 9999
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Alert"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Entrada inválida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Não autenticado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthorized",
              "invalid_input",
              "not_found",
              "invalid_transition",
              "ambiguous_value",
              "internal_error"
            ]
          }
        }
      },
      "Value": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "type",
              "amount"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "money"
              },
              "amount": {
                "type": "string",
                "pattern": "^-?\\d+(\\.\\d{1,2})?$"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "const": "text"
              },
              "text": {
                "type": "string"
              }
            }
          }
        ]
      },
      "ManualFieldInput": {
        "type": "object",
        "required": [
          "personId",
          "year",
          "key",
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "personId": {
            "type": "string",
            "minLength": 1
          },
          "year": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 9999
          },
          "key": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "$ref": "#/components/schemas/Value"
          }
        }
      },
      "CorrectionInput": {
        "type": "object",
        "required": [
          "value"
        ],
        "additionalProperties": false,
        "properties": {
          "value": {
            "$ref": "#/components/schemas/Value"
          }
        }
      },
      "Origin": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind",
              "enteredAt"
            ],
            "properties": {
              "kind": {
                "const": "manual"
              },
              "enteredAt": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "kind",
              "documentId",
              "page",
              "excerpt"
            ],
            "properties": {
              "kind": {
                "const": "document"
              },
              "documentId": {
                "type": "string"
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "excerpt": {
                "type": "string"
              }
            }
          }
        ]
      },
      "Field": {
        "type": "object",
        "required": [
          "id",
          "personId",
          "year",
          "key",
          "value",
          "status",
          "origin"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "personId": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "key": {
            "type": "string"
          },
          "value": {
            "$ref": "#/components/schemas/Value"
          },
          "status": {
            "type": "string",
            "enum": [
              "extracted",
              "confirmed",
              "corrected",
              "rejected"
            ]
          },
          "origin": {
            "$ref": "#/components/schemas/Origin"
          },
          "previousValue": {
            "$ref": "#/components/schemas/Value"
          }
        }
      },
      "Alert": {
        "type": "object",
        "required": [
          "validationId",
          "severity",
          "code",
          "fields",
          "documentIds",
          "suggestedAction",
          "state"
        ],
        "properties": {
          "validationId": {
            "type": "string",
            "enum": [
              "V-005",
              "V-011"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "error",
              "warning",
              "notice"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "sum_mismatch",
              "extracted_vs_manual_mismatch"
            ]
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "personId",
                "year",
                "key"
              ],
              "properties": {
                "personId": {
                  "type": "string"
                },
                "year": {
                  "type": "integer"
                },
                "key": {
                  "type": "string"
                }
              }
            }
          },
          "documentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "suggestedAction": {
            "type": "string",
            "enum": [
              "fix_value",
              "attach_document",
              "justify"
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "resolved",
              "justified"
            ]
          }
        }
      }
    }
  }
}
